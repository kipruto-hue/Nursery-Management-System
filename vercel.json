{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/.*\\.php$", "status": 404 },
    { "src": "/(includes|sql|backups)(/.*)?$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
