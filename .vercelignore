# Now that the app sits at the repo root, everything here is web-reachable.
# Keep non-runtime files out of the deployment entirely.

# sql/ now ships, because api/setup.php reads schema.sql and seed.php to
# initialise the database over HTTP (Vercel gives no shell). It is not
# web-reachable: vercel.json returns 404 for /sql/ and for every .php path.

# Apache-only; Vercel uses vercel.json instead.
.htaccess

# Dev-only router for `php -S`.
router.php

# Nightly backup job: needs mysqldump and a writable disk, neither of which
# exists on Vercel.
cron.php

backups/
*.log
